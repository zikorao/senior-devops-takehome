# Generate a usable, ignored .env with: python scripts/init_env.py
RABBITMQ_USER=takehome
RABBITMQ_PASSWORD=GENERATE_ME
REDIS_PASSWORD=GENERATE_ME
RABBITMQ_URL=amqp://takehome:GENERATE_ME@127.0.0.1:5672/
REDIS_URL=redis://:GENERATE_ME@127.0.0.1:6379/0
QUEUE_NAME=jobs
EXTERNAL_SERVICE_URL=http://127.0.0.1:8081/infer
MOCK_MODE=normal
MOCK_DELAY_SECONDS=8
